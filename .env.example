# meeting-bot — chaves de API
# Copie este arquivo para .env e preencha apenas as chaves do provedor que usar.
# O .env é lido automaticamente pelo CLI (nunca é commitado — está no .gitignore).
# Alternativa: salve em ~/.meeting-bot/.env para valer em qualquer diretório.

# ── Provedor de resumo (escolha um em: meeting-bot config set ai_provider <nome>) ──

# Anthropic (ai_provider=anthropic)
ANTHROPIC_API_KEY=  # <-- cole aqui sua chave da Anthropic (sk-ant-...)

# OpenAI (ai_provider=openai)
OPENAI_API_KEY=

# ── Transcrição ──
# Modelo Whisper local: tiny | base | small | medium | large
WHISPER_MODEL=small

# Token opcional do Hugging Face (acelera o download dos modelos Whisper)
HF_TOKEN=
